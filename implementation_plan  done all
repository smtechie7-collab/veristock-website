```javascript
function buildGstMatrix(sales) {
  const slabs = {};
  sales.forEach(s => {
    const items = Array.isArray(s.items) ? s.items : [];
    items.forEach(item => {
      const rate = item.gstRate || 18;
      if (!slabs[rate]) slabs[rate] = { taxable: 0, cgst: 0, sgst: 0, igst: 0 };
      const taxable = item.taxableAmountPaise ? item.taxableAmountPaise / 100 : (item.taxableAmount || 0);
      const tax = taxable * (rate / 100);
      slabs[rate].taxable += taxable;
      slabs[rate].cgst += tax / 2;
      slabs[rate].sgst += tax / 2;
    });
  });
  return slabs;
}
```

