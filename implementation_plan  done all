## P1-TASK-01: Implement Real Tab Visibility Listener Pause/Resume (CRIT-WEB-005)
**File:** [`js/services/firebaseService.js`](file:///C:/Users/sm/Desktop/veristockpro-android/web-app/js/services/firebaseService.js)  
**Effort:** 4 hours

### Full Implementation:
```javascript
// Replace the stub setupTabVisibilityManager() with actual logic
let _pausedListeners = [];
let _activeListeners = [];

export function registerManagedListener(unsub, isCritical = false) {
  _activeListeners.push({ unsub, isCritical });
  return unsub;
}

export function pauseNonCriticalListeners() {
  _activeListeners.forEach(l => {
    if (!l.isCritical) {
      l.unsub(); // Detach from Firestore
      _pausedListeners.push(l);
    }
  });
  _activeListeners = _activeListeners.filter(l => l.isCritical);
  console.log("[FinOps] Non-critical listeners paused. Active:", _activeListeners.length);
}

export function resumeAllListeners(reattachCallback) {
  // reattachCallback is called by the active module to re-subscribe
  if (reattachCallback) reattachCallback();
  console.log("[FinOps] Listeners resumed.");
}

function setupTabVisibilityManager() {
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "hidden") {
      pauseNonCriticalListeners();
    } else {
      // Signal app to re-mount the current module
      window.dispatchEvent(new CustomEvent("vrstk:tab-restored"));
    }
  });
}
```

