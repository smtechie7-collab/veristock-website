## P0-TASK-05: Fix Photo Storage — Firebase Storage Instead of Base64 (CRIT-WEB-005 / MED-WEB-004)
**File:** [`js/modules/oldDeviceBuy.js`](file:///C:/Users/sm/Desktop/veristockpro-android/web-app/js/modules/oldDeviceBuy.js)  
**Effort:** 1 day

### Problem
Photos stored as Base64 DataURIs directly in Firestore documents — violates Constitution Article 45 and exceeds 1MB document limit.

### Fix Architecture:
```javascript
// 1. Add Firebase Storage import to firebaseService.js
import { getStorage, ref, uploadString, getDownloadURL } 
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";

// 2. New upload helper in firebaseService.js
export async function uploadKycPhoto(businessId, shopId, docId, photoType, base64DataUri) {
  const storage = getStorage();
  const path = `businesses/${businessId}/shops/${shopId}/kyc_photos/${docId}/${photoType}.jpg`;
  const storageRef = ref(storage, path);
  await uploadString(storageRef, base64DataUri, 'data_url');
  return await getDownloadURL(storageRef);
}

// 3. In oldDeviceBuy.js form submit — upload first, then save URLs
const [idFrontUrl, customerUrl, deviceUrl] = await Promise.all([
  capturedPhotos.idFront ? uploadKycPhoto(bizId, shopId, docId, "id_front", capturedPhotos.idFront) : Promise.resolve(""),
  capturedPhotos.customer ? uploadKycPhoto(bizId, shopId, docId, "customer", capturedPhotos.customer) : Promise.resolve(""),
  capturedPhotos.device ? uploadKycPhoto(bizId, shopId, docId, "device", capturedPhotos.device) : Promise.resolve(""),
]);
// Then save URLs (not base64) in payload
payload.idFrontImagePath = idFrontUrl;
payload.customerPhotoPath = customerUrl;
payload.deviceImagePath = deviceUrl;
```

