```javascript
// sw.js
const CACHE_NAME = 'vrstk-v1';
const STATIC_ASSETS = ['/', '/index.html', '/css/app.css', '/css/print.css',
  '/js/app.js', '/js/config.js', '/app_icon_official.png'];

self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(cache => cache.addAll(STATIC_ASSETS))
  );
});

self.addEventListener('fetch', event => {
  event.respondWith(
    caches.match(event.request).then(cached => cached || fetch(event.request))
  );
});

// Web Outbox Sync — flush queued writes when online
self.addEventListener('sync', event => {
  if (event.tag === 'web-outbox-flush') {
    event.waitUntil(flushOutboxQueue());
  }
});
```

